{
  "name": "free-bbs",
  "version": "1.0.0",
  "description": "FREE-BBS learning platform homepage and auth backend",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "start:local": "bash scripts/start-local.sh",
    "start:frontend": "node server.js",
    "start:backend": "node backend/server.js",
    "testbench:fortune": "node test/testbench.js",
    "test:admin-users": "node --test scripts/admin-users-page.test.js",
    "test:course-maps": "node --test backend/course-maps.test.js scripts/course-map-pages.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.11",
    "marked": "^16.4.1",
    "mysql2": "^3.14.1",
    "nodemailer": "^6.10.0",
    "sharp": "^0.34.5",
    "three": "^0.184.0"
  },
  "keywords": [
    "free-bbs",
    "nodejs"
  ],
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.4"
  }
}
