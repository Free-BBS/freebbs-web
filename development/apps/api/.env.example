# Local defaults: in-memory data and deterministic demo identities.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
DATA_MODE=memory
AUTH_MODE=demo
# In AUTH_MODE=main, only these comma-separated main-site UIDs may enter.
# DEVELOPMENT_PREVIEW_UIDS=
DEMO_USER_IDS=demo-student,demo-admin,demo-rights-member,demo-liaison-member,demo-sports-lead,demo-sports-director,demo-captain,demo-tuanwei-lead
MAIN_SITE_API_BASE_URL=http://localhost:3000
AUTH_TIMEOUT_MS=3000
ALLOWED_ORIGINS=http://localhost:5173

# Private video directory outside web/static roots. Production requires an absolute persistent path.
# FESTIVAL_UPLOAD_DIR=/var/lib/freebbs-development/festival

# Required only when DATA_MODE=mysql. Never commit a real password.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=freebbs_development
# MYSQL_PASSWORD=replace-with-a-local-secret
# MYSQL_DATABASE=free_bbs_development
