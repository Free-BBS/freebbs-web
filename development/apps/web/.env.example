# Use demo only for local development. Production builds must use main or omit this variable.
VITE_AUTH_MODE=demo
# Optional local demo identity; accepted only when VITE_AUTH_MODE=demo.
# VITE_DEMO_USER_ID=demo-admin

# Set the published frEE bbs MAP HTTPS URL Link when available. Rebuild after changing.
# Empty keeps the "coming soon" entry.
VITE_FREE_BBS_MAP_URL=
