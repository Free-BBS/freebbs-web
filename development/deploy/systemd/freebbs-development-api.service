[Unit]
Description=FreeBBS Development API
After=network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/freebbs-development/current
ConditionPathExists=/etc/freebbs-development/development.env

[Service]
Type=simple
User=freebbs-development
Group=freebbs-development
WorkingDirectory=/opt/freebbs-development/current
EnvironmentFile=/etc/freebbs-development/development.env
ExecStart=/usr/bin/env NODE_ENV=production HOST=127.0.0.1 /usr/bin/node apps/api/dist/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0027
StateDirectory=freebbs-development
StateDirectoryMode=0700
Environment=FESTIVAL_UPLOAD_DIR=/var/lib/freebbs-development/festival

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
ReadOnlyPaths=/opt/freebbs-development/current

[Install]
WantedBy=multi-user.target
