# Installed once as /etc/freebbs-development/development.env (0640).
# Replace every CHANGE_ME value before deploying or starting services.
AUTH_MODE=main
# All authenticated main-site users can enter, including when this is empty.
# Legacy UID entries remain available to existing administrator directory tools.
DEVELOPMENT_PREVIEW_UIDS=
MAIN_SITE_API_BASE_URL=https://CHANGE_ME
AUTH_TIMEOUT_MS=3000
ALLOWED_ORIGINS=https://CHANGE_ME
DATA_MODE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=free_bbs_development
MYSQL_USER=freebbs_development_app
MYSQL_PASSWORD=CHANGE_ME
PORT=3100
HOST=127.0.0.1
FESTIVAL_UPLOAD_DIR=/var/lib/freebbs-development/festival
COLLECTIONS_UPLOAD_DIR=/var/lib/freebbs-development/collections
# Private finance storage must remain outside all uploads/public/static roots.
FINANCE_DATA_DIR=/var/lib/freebbs-development/finance
# Finance follows shared organization appointments and the configured platform root.
# Optional additional root UIDs, comma-separated. Does not remove the appointed default.
# PLATFORM_ROOT_ADMIN_UIDS=
