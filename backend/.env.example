API_HOST=127.0.0.1
API_PORT=3001
NODE_ENV=development
PUBLIC_WEB_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:3000
BACKEND_IP=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=free_bbs
AUTH_SECRET=replace-this-in-production
AGENT_URL=http://127.0.0.1:5001
# Keep these blank/false for Web-only local development. Production deployments
# that expose the internal Agent settings API must replace them with real values.
AGENT_SERVICE_TOKEN=
AGENT_SETTINGS_REQUIRED=false
AGENT_SETTINGS_SOCKET=
SETTINGS_ENCRYPTION_KEY=
# Modes: disabled, direct_cas, official, development_mock
# direct_cas is a compatibility mode, not an official CAS callback.
# It accepts a password for one login request and never persists the raw password.
# Successful Learn cookies are stored only as an AES-256-GCM encrypted cookie jar.
# After explicit consent, the browser creates a 32-hex device fingerprint compatible
# with Tsinghua's current login page. It is request-only, never persisted or echoed.
# Encrypted Learn sessions have an 8-hour server hard limit (or earlier cookie expiry).
# CAPTCHA/second-factor challenges fail closed; Info private sync is not implemented.
TSINGHUA_CONNECTOR_MODE=disabled
TSINGHUA_CONNECTOR_ADAPTER_ID=tsinghua_direct_cas
TSINGHUA_CONNECTOR_CALLBACK_URL=
# Required by direct_cas and official: use an independent 32-byte key.
# Do not reuse passwords, cookies, AUTH_SECRET, or SETTINGS_ENCRYPTION_KEY.
TSINGHUA_CONNECTOR_ENCRYPTION_KEY=
TSINGHUA_CONNECTOR_WORKER_SOCKET=
TSINGHUA_CONNECTOR_STATE_TTL_SECONDS=600
TSINGHUA_CONNECTOR_SYNC_INTERVAL_SECONDS=300
LLM_BASE_URL=https://cloud.infini-ai.com/maas/v1
LLM_MODEL=glm-5.1
COURSE_MATERIALS_ALLOWED_ROOT=/data/free-bbs/courses
COURSE_MATERIALS_ROOT=/data/free-bbs/courses
SANDBOX_URL=http://127.0.0.1:8000
SANDBOX_OUTPUT_DIR=/data/www/free-BBS-sandbox/outputs
BOTMAIL_SMTP=smtp.feishu.cn
BOTMAIL_SMTP_PORT=465
BOTMAIL_USER=your-bot-mail@example.com
BOTMAIL_FROM=your-bot-mail@example.com
BOTMAIL_PASS=replace-with-real-password
