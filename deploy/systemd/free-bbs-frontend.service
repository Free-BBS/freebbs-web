[Unit]
Description=FREE-BBS frontend
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/www/free-BBS
EnvironmentFile=/etc/free-bbs/frontend.env
ExecStart=/usr/bin/env npm run start:frontend
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
User=freebbs-frontend
Group=freebbs-frontend

[Install]
WantedBy=multi-user.target
